# Copy to .env (git-ignored) and fill in values. Never commit real values.

# --- Analysis pipeline -------------------------------------------------------
# Random secret (32+ chars) for HMAC pseudonymous customer keys.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CUSTOMERPULSE_PSEUDONYM_SECRET=

# --- Database connection URLs (one per least-privilege role) ---------------
# Admin connection, only for `customerpulse setup-roles`.
ADMIN_DATABASE_URL=postgresql://<admin_user>:<password>@<host>:<port>/customerpulse
# Schema owner, used by Alembic migrations.
MIGRATOR_DATABASE_URL=postgresql://cp_migrator:<password>@<host>:<port>/customerpulse
# Analysis writer, used by `customerpulse persist`.
WRITER_DATABASE_URL=postgresql://cp_writer:<password>@<host>:<port>/customerpulse
# Read-only role, used by the public API.
DATABASE_URL=postgresql://cp_reader:<password>@<host>:<port>/customerpulse

# Passwords applied to the three roles by `customerpulse setup-roles`.
CP_MIGRATOR_PASSWORD=
CP_WRITER_PASSWORD=
CP_READER_PASSWORD=

# --- API ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Tests -------------------------------------------------------------------
# Admin URL to a NON-production server where `customerpulse_test` may be
# created and dropped. Leave empty to skip database tests.
CUSTOMERPULSE_TEST_ADMIN_URL=

# --- Local development cluster (optional) -----------------------------------
LOCAL_PG_PORT=55432
LOCAL_PG_ADMIN_PASSWORD=
